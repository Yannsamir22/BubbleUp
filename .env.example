# Copy to .env and adjust. Every value is optional in development.

# Port the server listens on (http://localhost:3000)
PORT=3000

# REQUIRED in production: a long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the database and uploaded files are stored (default: ./data)
DATA_DIR=./data

# Max size of a single uploaded file, in MB
MAX_UPLOAD_MB=25

# Optional: free key from https://www.pexels.com/api/ to enable "/image cats"
PEXELS_API_KEY=

# Optional HTTPS for classroom LAN use (enables voice notes + notifications on other devices)
# HTTPS_KEY_FILE=./certs/key.pem
# HTTPS_CERT_FILE=./certs/cert.pem

# Behind a reverse proxy or PaaS (Render, Railway, nginx) set TRUST_PROXY=1 so HTTPS is detected.
# TRUST_PROXY=1
# Force the Secure cookie flag on/off (default: automatic, based on HTTPS)
# COOKIE_SECURE=true

# Weekly awards (posted by Thinkmas in #general). Day: 0=Sunday … 5=Friday; hour in server time.
# AWARDS_ENABLED=true
# AWARDS_DAY=5
# AWARDS_HOUR=15
